<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the splash screen from the theme: the app's
         background, with the icon on its round dark teal background in the middle. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
    </style>
</resources>

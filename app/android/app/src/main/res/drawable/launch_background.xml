<?xml version="1.0" encoding="utf-8"?>
<!-- The splash screen before Android 12, and what shows after Android 12's
     own splash screen until Flutter draws its first frame: the app's
     background, with the icon in the middle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:drawable="@drawable/splash_icon"
        android:gravity="center" />
</layer-list>

{
  "@@locale": "en",

  "appTitle": "Cephalopod",
  "@appTitle": {
    "description": "The game's name: the app's title, and the heading on Home and About. Mark Steere's name for the game; not translated."
  },

  "homeTagline": "A two-player dice game on a 5×5 board.",
  "@homeTagline": {
    "description": "Home: the line under the game's name."
  },
  "homeContinue": "Continue",
  "@homeContinue": {
    "description": "Home: button that picks up the saved game."
  },
  "homeNewGame": "New game",
  "@homeNewGame": {
    "description": "Home: button that opens the new-game dialog."
  },
  "homeHowToPlay": "How to play",
  "@homeHowToPlay": {
    "description": "Home: button that opens the rules tutorial."
  },
  "homeSettings": "Settings",
  "@homeSettings": {
    "description": "Home: button that opens the settings."
  },
  "homeAbout": "About",
  "@homeAbout": {
    "description": "Home: button that opens the credits and the official rules."
  },

  "settingsTitle": "Settings",
  "@settingsTitle": {
    "description": "Settings: the page's title."
  },
  "settingsTheme": "Theme",
  "@settingsTheme": {
    "description": "Settings: heading above the light, dark or system choice."
  },
  "settingsThemeSystem": "System",
  "@settingsThemeSystem": {
    "description": "Settings: theme choice that follows the device's light or dark setting."
  },
  "settingsThemeLight": "Light",
  "@settingsThemeLight": {
    "description": "Settings: theme choice that is always light."
  },
  "settingsThemeDark": "Dark",
  "@settingsThemeDark": {
    "description": "Settings: theme choice that is always dark."
  },
  "settingsHighlightLastMove": "Highlight the last move",
  "@settingsHighlightLastMove": {
    "description": "Settings: switch that marks the square of the last die placed."
  },

  "aboutTitle": "About",
  "@aboutTitle": {
    "description": "About: the page's title."
  },
  "aboutCredit": "Cephalopod was invented by Mark Steere on February 25, 2006. This app follows his rules without changes.",
  "@aboutCredit": {
    "description": "About: credits the game's inventor, as his rule sheet asks of anyone who programs the game."
  },
  "aboutOfficialRules": "Official rules",
  "@aboutOfficialRules": {
    "description": "About: heading above the link to the official rule sheet."
  },
  "aboutVersion": "Version {version} (build {build})",
  "@aboutVersion": {
    "description": "About: under the game's name, the app's version and its build number.",
    "placeholders": {
      "version": {
        "type": "String",
        "example": "1.2.0"
      },
      "build": {
        "type": "String",
        "example": "14"
      }
    }
  },

  "gamePlayerName": "Player {number}",
  "@gamePlayerName": {
    "description": "A player between two people on the same device, by number: Player 1 plays first.",
    "placeholders": {
      "number": {
        "type": "int"
      }
    }
  },

  "gameHeadlinePlayerToMove": "{player} to move",
  "@gameHeadlinePlayerToMove": {
    "description": "Game: above the board, between two people. {player} is gamePlayerName.",
    "placeholders": {
      "player": {
        "type": "String"
      }
    }
  },
  "gameHeadlinePersonToMove": "Your turn",
  "@gameHeadlinePersonToMove": {
    "description": "Game: above the board, against the computer, when the person is to move."
  },
  "gameHeadlineComputerToMove": "The computer is thinking…",
  "@gameHeadlineComputerToMove": {
    "description": "Game: above the board while the computer chooses its move."
  },
  "gameHeadlinePlayerWon": "{player} wins {winnerDice} to {loserDice}",
  "@gameHeadlinePlayerWon": {
    "description": "Game: above the board when a game between two people ends. The numbers are the dice each player has on the full board, the winner's first.",
    "placeholders": {
      "player": {
        "type": "String"
      },
      "winnerDice": {
        "type": "int"
      },
      "loserDice": {
        "type": "int"
      }
    }
  },
  "gameHeadlinePersonWon": "You win {winnerDice} to {loserDice}",
  "@gameHeadlinePersonWon": {
    "description": "Game: above the board when the person beats the computer. Dice on the board, the person's first.",
    "placeholders": {
      "winnerDice": {
        "type": "int"
      },
      "loserDice": {
        "type": "int"
      }
    }
  },
  "gameHeadlineComputerWon": "The computer wins {winnerDice} to {loserDice}",
  "@gameHeadlineComputerWon": {
    "description": "Game: above the board when the computer wins. Dice on the board, the computer's first.",
    "placeholders": {
      "winnerDice": {
        "type": "int"
      },
      "loserDice": {
        "type": "int"
      }
    }
  },

  "gameHeadlineAfterComputerMove": "The computer placed a {pips} at row {row}, column {column}. {headline}",
  "@gameHeadlineAfterComputerMove": {
    "description": "Game: what a screen reader says for the line above the board right after the computer moved, so one announcement tells both what it did and whose turn it is. {pips} is the number on the die it placed, 1 to 6; rows and columns count from 1 at the top left; {headline} is the line above the board, such as gameHeadlinePersonToMove.",
    "placeholders": {
      "pips": {
        "type": "int"
      },
      "row": {
        "type": "int"
      },
      "column": {
        "type": "int"
      },
      "headline": {
        "type": "String"
      }
    }
  },

  "gameCaptureSum": "Capture sum: {selectedSum} of up to {maxSum}",
  "@gameCaptureSum": {
    "description": "Game: while the player picks dice to capture, the sum of their pips so far and the most a capture may add up to.",
    "placeholders": {
      "selectedSum": {
        "type": "int"
      },
      "maxSum": {
        "type": "int"
      }
    }
  },

  "gameSquareEmpty": "Row {row}, column {column}, empty",
  "@gameSquareEmpty": {
    "description": "Game: what a screen reader says for an empty square. Rows and columns count from 1 at the top left.",
    "placeholders": {
      "row": {
        "type": "int"
      },
      "column": {
        "type": "int"
      }
    }
  },
  "gameSquarePlayerDie": "Row {row}, column {column}, {player} die showing {pips}",
  "@gameSquarePlayerDie": {
    "description": "Game: what a screen reader says for a square with a die, between two people. {player} is gamePlayerName; {pips} is the number on the die, 1 to 6.",
    "placeholders": {
      "row": {
        "type": "int"
      },
      "column": {
        "type": "int"
      },
      "player": {
        "type": "String"
      },
      "pips": {
        "type": "int"
      }
    }
  },
  "gameSquareYourDie": "Row {row}, column {column}, your die showing {pips}",
  "@gameSquareYourDie": {
    "description": "Game: what a screen reader says for a square with the person's die, against the computer. {pips} is 1 to 6.",
    "placeholders": {
      "row": {
        "type": "int"
      },
      "column": {
        "type": "int"
      },
      "pips": {
        "type": "int"
      }
    }
  },
  "gameSquareComputerDie": "Row {row}, column {column}, the computer's die showing {pips}",
  "@gameSquareComputerDie": {
    "description": "Game: what a screen reader says for a square with the computer's die. {pips} is 1 to 6.",
    "placeholders": {
      "row": {
        "type": "int"
      },
      "column": {
        "type": "int"
      },
      "pips": {
        "type": "int"
      }
    }
  },

  "howToPlayProgress": "Step {step} of {stepCount}",
  "@howToPlayProgress": {
    "description": "How to play: what a screen reader says for the dots under the pages. Steps count from 1.",
    "placeholders": {
      "step": {
        "type": "int"
      },
      "stepCount": {
        "type": "int"
      }
    }
  },

